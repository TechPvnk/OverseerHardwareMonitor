<Window x:Class="Overseer.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Overseer"
        xmlns:services="clr-namespace:Overseer.Services"
        mc:Ignorable="d" Title="{services:Loc AppTitle}" Height="250" Width="450"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="#1E1E1E" CornerRadius="1">
        <Grid Margin="0">
            <!-- App Title -->
            <Image Source="/Themes/Splash.png"
                   Stretch="UniformToFill" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>

            <!-- Progress & Status Container -->
            <StackPanel VerticalAlignment="Bottom">
                <!-- Status Label -->
                <TextBlock x:Name="StatusText" 
                           Text="{services:Loc SplashInitializing}" 
                           Foreground="#de0200" 
                           FontSize="11" 
                           FontFamily="Consolas"
                           Margin="0,0,0,4
                           " 
                           HorizontalAlignment="Center" />

                <!-- Indeterminate Progress Bar -->
                <ProgressBar IsIndeterminate="True" 
                             Height="4" 
                             Background="#1E1E1E" 
                             Foreground="#de0200" 
                             BorderBrush="#de0200"
                             Margin="0,0,0,26"
                             BorderThickness="1" Width="218"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
