<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#181818"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#242424"/>
    <SolidColorBrush x:Key="MenuBrush" Color="#202020"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#252526"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#3B3B3B"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#707070"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#BE2331"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D53746"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#8D1D28"/>

    <!-- Menu -->
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#BE2331"/>
    <SolidColorBrush x:Key="MenuSelectedBrush" Color="#8D1D28"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#404040"/>

</ResourceDictionary>