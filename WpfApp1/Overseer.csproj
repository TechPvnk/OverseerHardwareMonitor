<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Force x64 runtime to ensure native sensor drivers can be loaded properly -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Themes\favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Overseer</AssemblyName>
    <RootNamespace>Overseer</RootNamespace>
  </PropertyGroup>
  <!-- Vortice.DXGI removed: using native DXGI interop implementation instead -->

  <ItemGroup>
    <None Remove="Themes\favicon.ico" />
    <None Remove="Themes\oshmfavicon.png" />
    <None Remove="Themes\Splash.png" />
    <None Remove="Themes\overseer-brand.png" />
    <None Remove="Fonts\Quantico-Regular.ttf" />
    <None Remove="Fonts\Quantico-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Themes\favicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Themes\favicon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Themes\oshmfavicon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Themes\Splash.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Themes\overseer-brand.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Fonts\Quantico-Regular.ttf" />
    <Resource Include="Fonts\Quantico-Bold.ttf" />
  </ItemGroup>

  <!-- Include repository docs in publish output -->
  <ItemGroup>
    <None Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Bundle helper binaries placed under 'helpers' into the publish output so the app can run them locally -->
  <ItemGroup>
    <Content Include="helpers\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <!-- Prevent the publish single-file bundler from embedding these native helper EXEs
           so they remain as separate files next to the app after publish. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Smartmontools remains a separately distributed GPL executable. Do not embed it in single-file output. -->
  <ItemGroup>
    <Content Include="ThirdParty\Smartmontools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
