<Window x:Class="Overseer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Overseer.Views"
        xmlns:services="clr-namespace:Overseer.Services"
        mc:Ignorable="d"
        Icon="/Themes/favicon.ico"
        Title="{services:Loc AppTitle}" Height="937" Width="864" MinHeight="620" MinWidth="840"
        Background="#121212" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <views:TemperatureStatusBrushConverter x:Key="TemperatureStatusBrushConverter"/>
        <DataTemplate DataType="{x:Type services:SmartctlDriveReport}">
            <Border Background="#141516" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{services:Loc SmartctlDeviceReport}" Style="{StaticResource SectionLabelTextStyle}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{services:Loc ColumnModel}" Style="{StaticResource MetricTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Model}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Grid.Column="2" Text="{services:Loc ColumnFirmware}" Style="{StaticResource MetricTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="{Binding FirmwareVersion}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Grid.Row="1" Text="{services:Loc ColumnSerial}" Style="{StaticResource MetricTextStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SerialNumber}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{services:Loc ColumnCapacity}" Style="{StaticResource MetricTextStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Capacity}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Grid.Row="2" Text="{services:Loc ColumnProtocol}" Style="{StaticResource MetricTextStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Protocol}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource TelemetryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{services:Loc ColumnSmartStatus}" Style="{StaticResource MetricTextStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SmartPassed}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource TelemetryBrush}"/>
                    </Grid>

                    <StackPanel x:Name="NvmeHealthPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NvmeHealth}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{services:Loc NvmeAttributes}" Style="{StaticResource SectionLabelTextStyle}" Margin="0,12,0,5"/>
                        <Grid Background="#202123">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{services:Loc ColumnId}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="1" Text="{services:Loc ColumnAttribute}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="2" Text="{services:Loc ColumnCurrent}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="3" Text="{services:Loc ColumnThreshold}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="4" Text="{services:Loc ColumnRaw}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding NvmeHealth.Attributes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="#18191A">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Current}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource TelemetryBrush}" Margin="5,2"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Threshold}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                        <TextBlock Grid.Column="4" Text="{Binding RawValue}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="AtaAttributesPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AtaAttributes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{services:Loc SataAttributes}" Style="{StaticResource SectionLabelTextStyle}" Margin="0,12,0,5"/>
                        <Grid Background="#202123">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{services:Loc ColumnId}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="1" Text="{services:Loc ColumnAttribute}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="2" Text="{services:Loc ColumnValue}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="3" Text="{services:Loc ColumnWorst}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="4" Text="{services:Loc ColumnThresh}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                            <TextBlock Grid.Column="5" Text="{services:Loc ColumnRaw}" Style="{StaticResource MetricTextStyle}" Margin="5,3"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AtaAttributes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="#18191A">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Worst}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Threshold}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                        <TextBlock Grid.Column="5" Text="{Binding RawValue}" Style="{StaticResource MetricTextStyle}" Margin="5,2"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Margin="2,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PanelBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource CardInsetBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Background="black" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="{services:Loc MenuFile}">
                <MenuItem Header="{services:Loc CommandExportData}" InputGestureText="Ctrl+S">
                    <MenuItem Header="txt" Click="ExportTxtMenuItem_Click"/>
                    <MenuItem Header="csv" Click="ExportCsvMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="{services:Loc CommandExportScreenshot}" InputGestureText="Ctrl+Shift+S" Click="ExportScreenshotMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="{services:Loc CommandExit}" InputGestureText="Alt+F4" Click="ExitMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{services:Loc MenuEdit}">
                <MenuItem Header="{services:Loc CommandCopyCurrentTab}" InputGestureText="Ctrl+Shift+C" Click="CopyCurrentTabMenuItem_Click"/>
                <MenuItem Header="{services:Loc CommandCopyAllTabs}" InputGestureText="Ctrl+Alt+C" Click="CopyAllTabsMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{services:Loc MenuTools}">
                <MenuItem Header="{services:Loc CommandResetStatistics}" InputGestureText="F5" Click="ResetStatisticsMenuItem_Click"/>
                <MenuItem Header="{services:Loc CommandRefreshSystemInformation}" Click="RefreshSystemInformationMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="{services:Loc CommandOpenLog}"/>
                <MenuItem x:Name="AlertSoundMenuItem" Header="{services:Loc CommandAlertSound}" IsCheckable="True" IsChecked="True" Click="AlertSoundMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{services:Loc MenuView}">
                <MenuItem Header="{services:Loc CommandAlwaysOnTop}" IsCheckable="True" Click="AlwaysOnTopMenuItem_Click"/>
                <MenuItem x:Name="MinimizeToTrayMenuItem" Header="{services:Loc CommandMinimizeToTray}" IsCheckable="True" Click="MinimizeToTrayMenuItem_Click"/>
                <MenuItem Header="{services:Loc MenuTemperature}">
                    <MenuItem x:Name="CelsiusMenuItem" Header="{services:Loc TemperatureCelsius}" IsCheckable="True" IsChecked="True" Click="CelsiusMenuItem_Click"/>
                    <MenuItem x:Name="FahrenheitMenuItem" Header="{services:Loc TemperatureFahrenheit}" IsCheckable="True" Click="FahrenheitMenuItem_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{services:Loc MenuDebug}">
                    <MenuItem Header="{services:Loc CommandLogWmiQueries}" IsCheckable="True" IsChecked="{Binding LogWmiQueries, Mode=TwoWay}"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{services:Loc MenuLanguage}">
                <MenuItem x:Name="EnglishMenuItem" Header="{services:Loc LanguageEnglish}" IsCheckable="True" Click="EnglishMenuItem_Click"/>
                <MenuItem x:Name="SpanishMenuItem" Header="{services:Loc LanguageSpanish}" IsCheckable="True" Click="SpanishMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="{services:Loc MenuHelp}">
                <MenuItem Header="{services:Loc HelpDocumentation}"
              Click="DocumentationMenuItem_Click"/>

                <MenuItem Header="TechPvnk"
              Click="TechPvnkMenuItem_Click"/>

                <MenuItem Header="{services:Loc HelpReadings}"
              Click="ReadingsHelpMenuItem_Click"/>

                <MenuItem Header="{services:Loc HelpCheckUpdates}"
              Click="CheckForUpdatesMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="{services:Loc HelpAbout}" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#101112" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{services:Loc BrandSubtitle}" FontFamily="{StaticResource DisplayFont}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Height="14" Margin="0,30,0,0"/>
                </StackPanel>
                <Image Source="/Themes/overseerlogo.png" Height="48" Width="217" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-9,0,0"/>
                <Image Source="/Themes/overseer-logo-mascot.png" Height="52" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="720,0,0,0" Width="87"/>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="15,12,15,15" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}">

            <TabItem Header="{services:Loc TabTemps}" Tag="Temps">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <Border Style="{StaticResource ContentCardStyle}" Background="{StaticResource CardInsetBrush}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.ColumnSpan="2" Width="3" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{Binding CpuTemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" Opacity="0.85"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{services:Loc SectionCpu}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding CpuModel}" Style="{StaticResource CardTitleTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding CpuTemperature}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Foreground="{Binding CpuTemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" Margin="0,10,0,0"/>
                                    <views:TemperatureStatusBar Status="{Binding CpuTemperatureStatus}" Height="5" Margin="0,7,24,0"/>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <TextBlock Text="{services:LocFormat FormatMin, Path=CpuMinTemperature}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatMax, Path=CpuMaxTemperature}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatUsage, Path=CpuUsage}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatPower, Path=CpuPower}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatMinPower, Path=CpuMinPower}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatMaxPower, Path=CpuMaxPower}" Style="{StaticResource MetricTextStyle}"/>
                                    </UniformGrid>
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="16,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <views:Sparkline Values="{Binding CpuTemperatureHistory}" MaxValue="110" Stroke="{Binding CpuTemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" ShowAxisLabels="True" Height="88"/>
                                    <views:Sparkline Grid.Row="2" Values="{Binding CpuUsageHistory}" MaxValue="100" Stroke="{StaticResource WarningBrush}" Height="88"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ContentCardStyle}" Background="{StaticResource CardInsetBrush}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.ColumnSpan="2" Width="3" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{Binding GpuTemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" Opacity="0.85"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{services:Loc SectionGpu}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding GpuModel}" Style="{StaticResource CardTitleTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding GpuTemperature}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Foreground="{Binding GpuTemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" Margin="0,10,0,0"/>
                                    <views:TemperatureStatusBar Status="{Binding GpuTemperatureStatus}" Height="5" Margin="0,7,24,0"/>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <TextBlock Text="{services:LocFormat FormatMin, Path=GpuMinTemperature}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatMax, Path=GpuMaxTemperature}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatUsage, Path=GpuUsage}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatPower, Path=GpuPower}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatMinPower, Path=GpuMinPower}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatMaxPower, Path=GpuMaxPower}" Style="{StaticResource MetricTextStyle}"/>
                                    </UniformGrid>
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="16,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <views:Sparkline Values="{Binding GpuTemperatureHistory}" MaxValue="110" Stroke="{Binding GpuTemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" ShowAxisLabels="True" Height="88"/>
                                    <views:Sparkline Grid.Row="2" Values="{Binding GpuUsageHistory}" MaxValue="100" Stroke="{StaticResource WarningBrush}" Height="88"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ContentCardStyle}" Background="{StaticResource CardInsetBrush}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.ColumnSpan="2" Width="3" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource WarningBrush}" Opacity="0.75"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{services:Loc SectionRam}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding RamTotal}" Style="{StaticResource CardTitleTextStyle}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding RamUsage}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0"/>
                                    <UniformGrid Columns="2" Margin="0,13,0,0">
                                        <TextBlock Text="{services:LocFormat FormatUsed, Path=RamUsed}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatAvailable, Path=RamAvailable}" Style="{StaticResource MetricTextStyle}"/>
                                        <TextBlock Text="{services:LocFormat FormatTemperature, Path=RamTemperature}" Style="{StaticResource MetricTextStyle}" Foreground="{StaticResource MutedTextBrush}"/>
                                    </UniformGrid>
                                </StackPanel>
                                <views:Sparkline Grid.Column="1" Values="{Binding RamUsageHistory}" MaxValue="100" Stroke="{StaticResource WarningBrush}" Height="88" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ContentCardStyle}" Background="{StaticResource CardInsetBrush}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc SectionDriveTemperatures}" Style="{StaticResource SectionLabelTextStyle}"/>

                                <ItemsControl ItemsSource="{Binding DriveTemperatures}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="8" Margin="0,0,0,8" BorderBrush="{Binding TemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" BorderThickness="1,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="230"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleTextStyle}"/>
                                                        <TextBlock Text="{Binding Temperature}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Foreground="{Binding TemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" Margin="0,10,0,0"/>
                                                        <views:TemperatureStatusBar Status="{Binding TemperatureStatus}" Height="5" Margin="0,7,24,0"/>
                                                        <UniformGrid Columns="2" Margin="0,8,0,0">
                                                            <TextBlock Text="{services:LocFormat FormatMin, Path=MinTemperature}" Style="{StaticResource MetricTextStyle}"/>
                                                            <TextBlock Text="{services:LocFormat FormatMax, Path=MaxTemperature}" Style="{StaticResource MetricTextStyle}"/>
                                                        </UniformGrid>
                                                    </StackPanel>

                                                    <views:Sparkline Grid.Column="1" Values="{Binding History}" MaxValue="110" Stroke="{Binding TemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" ShowAxisLabels="True" Height="88" Margin="16,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{services:Loc TabDiskHealth}" Tag="DiskHealth">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{services:Loc SectionStorage}" Style="{StaticResource SectionLabelTextStyle}"/>
                        <TextBlock Text="{services:Loc StorageConnectedDrives}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource CardInsetBrush}">
                        <ItemsControl ItemsSource="{Binding StorageDrives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ContentCardStyle}" Padding="0" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ToggleButton x:Name="ExpandToggle" Background="Transparent" BorderThickness="0" Padding="12" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="HeaderSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HeaderSurface" Property="Background" Value="#25272A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="HeaderSurface" Property="Background" Value="#202224"/>
                                                                <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleTextStyle}" FontSize="14"/>
                                                        <TextBlock Text="{services:LocFormat FormatInterface, Path=InterfaceType}" Foreground="{StaticResource TelemetryBrush}" Margin="0,5,0,0" Style="{StaticResource MetricTextStyle}"/>
                                                        <TextBlock Text="{Binding ErrorFlag}" Style="{StaticResource MetricTextStyle}"/>
                                                    </StackPanel>

                                                    <UniformGrid Grid.Column="1" Columns="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{services:LocFormat FormatTemperature, Path=Temperature}" Foreground="{Binding TemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" Style="{StaticResource MetricTextStyle}"/>
                                                        <views:TemperatureStatusBar Status="{Binding TemperatureStatus}" Height="4" Margin="0,4,24,2"/>
                                                        <TextBlock Text="{services:LocFormat FormatLifeLeft, Path=LifeRemaining}" Foreground="#DCDCAA" Margin="0,2,0,0" Style="{StaticResource MetricTextStyle}"/>
                                                    </UniformGrid>

                                                    <UniformGrid Grid.Column="2" Columns="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{services:LocFormat FormatReads, Path=TotalReads}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                        <TextBlock Text="{services:LocFormat FormatWrites, Path=TotalWrites}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                        <TextBlock Text="{services:LocFormat FormatPowerCycles, Path=PowerOnCount}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                        <TextBlock Text="{services:LocFormat FormatPowerHours, Path=PowerOnHours}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                    </UniformGrid>

                                                    <Border Grid.Column="3" Background="#292A2C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9,5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HealthStatus}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" Foreground="#4EC9B0" FontSize="12"/>
                                                    </Border>
                                                    <Path x:Name="ExpandChevron" Grid.Column="4" Data="M 2 3 L 10 11 L 18 3" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" CenterX="10" CenterY="7"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </ToggleButton>

                                            <Border x:Name="DetailsPanel" Grid.Row="1" Height="0" Opacity="0" ClipToBounds="True" Background="#171819" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel>
                                                        <Grid Margin="12" Visibility="Collapsed">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.ColumnSpan="2" Text="SMART &amp; HEALTH DETAILS" Style="{StaticResource SectionLabelTextStyle}" Margin="0,0,0,8"/>

                                                            <Grid Grid.Row="1" Margin="0,0,14,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Health status" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding HealthStatus}" Foreground="#4EC9B0" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>
                                                            <Grid Grid.Row="1" Grid.Column="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Temperature" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Temperature}" Foreground="{Binding TemperatureStatus, Converter={StaticResource TemperatureStatusBrushConverter}}" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>

                                                            <Grid Grid.Row="2" Margin="0,7,14,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Life remaining" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding LifeRemaining}" Foreground="#DCDCAA" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>
                                                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,7,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Interface" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding InterfaceType}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>

                                                            <Grid Grid.Row="3" Margin="0,7,14,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Total host reads" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding TotalReads}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>
                                                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,7,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Total host writes" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding TotalWrites}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>

                                                            <Grid Grid.Row="4" Margin="0,7,14,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Power cycles" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding PowerOnCount}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>
                                                            <Grid Grid.Row="4" Grid.Column="1" Margin="0,7,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Power-on hours" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding PowerOnHours}" Foreground="{StaticResource TelemetryBrush}" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>

                                                            <Grid Grid.Row="5" Margin="0,7,14,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="145"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Reported errors" Style="{StaticResource MetricTextStyle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ErrorFlag}" Style="{StaticResource MetricTextStyle}"/>
                                                            </Grid>

                                                            <ContentControl Grid.Row="6" Grid.ColumnSpan="2" Content="{Binding SmartctlData}"/>
                                                        </Grid>
                                                        <ContentControl Content="{Binding SmartctlData}" Margin="12"/>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="ExpandToggle" Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DetailsPanel" Storyboard.TargetProperty="Height" To="540" Duration="0:0:0.28"/>
                                                        <DoubleAnimation Storyboard.TargetName="DetailsPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                                        <DoubleAnimation Storyboard.TargetName="ExpandChevron" Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DetailsPanel" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="DetailsPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="ExpandChevron" Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.16"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{services:Loc TabSystemInfo}" Tag="SystemInfo">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionCpu}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding CpuModel}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatClock, Path=CpuClock}" Style="{StaticResource MetricTextStyle}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatCoresThreads, Path=CpuCoresThreads}" Style="{StaticResource MetricTextStyle}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatCaches, Path=CpuCaches}" Style="{StaticResource MetricTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{services:LocFormat FormatTdp, Path=CpuTdp}" Style="{StaticResource MetricTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionRam}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding RamInfo}" Style="{StaticResource CardTitleTextStyle}" Margin="0,6,0,0"/>
                                    <!-- Total and Clock are shown in the main RamInfo line; hide duplicate fields -->
                                    <ItemsControl ItemsSource="{Binding RamModulesList}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MetricTextStyle}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ContentCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionGpu}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding GpuModel}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatClock, Path=GpuClock}" Style="{StaticResource MetricTextStyle}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatRam, Path=GpuRam}" Style="{StaticResource MetricTextStyle}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatMemoryTotal, Path=GpuMemoryTotal}" Style="{StaticResource MetricTextStyle}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatMemoryUsed, Path=GpuMemoryUsed}" Style="{StaticResource MetricTextStyle}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatMemoryFree, Path=GpuMemoryFree}" Style="{StaticResource MetricTextStyle}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{services:LocFormat FormatBus, Path=GpuBus}" Style="{StaticResource MetricTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ContentCardStyle}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionAudio}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <ItemsControl ItemsSource="{Binding AudioDevices}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MetricTextStyle}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{services:Loc NoAudioDevices}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetricTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AudioDevices.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionMotherboard}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding Motherboard}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <ItemsControl ItemsSource="{Binding MotherboardSubHardware}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MetricTextStyle}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionBios}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding Bios}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionOperatingSystem}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding OsVersion}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ContentCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionBattery}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <TextBlock Text="{Binding BatteryInfo}" Style="{StaticResource MetricTextStyle}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ContentCardStyle}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc SectionGraphics}" Style="{StaticResource SectionLabelTextStyle}"/>
                                    <ItemsControl ItemsSource="{Binding GraphicsDevices}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MetricTextStyle}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{services:Loc NoGraphicsDevices}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetricTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GraphicsDevices.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>


