<Window x:Class="Overseer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Overseer.Views"
        mc:Ignorable="d"
        Icon="/Themes/favicon.ico"
        Title="Overseer - Hardware Monitor" Height="720" Width="980" MinHeight="620" MinWidth="840"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="#3F3F3F" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="2,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#FF3B30"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#FF3B30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource MenuBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Background="{StaticResource MenuBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="Export data" InputGestureText="Ctrl+S">
                    <MenuItem Header="txt" Click="ExportTxtMenuItem_Click"/>
                    <MenuItem Header="csv" Click="ExportCsvMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Export screenshot" InputGestureText="Ctrl+Shift+S" Click="ExportScreenshotMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="ExitMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Copy current tab" InputGestureText="Ctrl+Shift+C" Click="CopyCurrentTabMenuItem_Click"/>
                <MenuItem Header="Copy all tabs" InputGestureText="Ctrl+Alt+C" Click="CopyAllTabsMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="Reset Statistics" InputGestureText="F5" Click="ResetStatisticsMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Open Log"/>
                <MenuItem x:Name="AlertSoundMenuItem" Header="Alert sound" IsCheckable="True" IsChecked="True" Click="AlertSoundMenuItem_Click"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Always On Top" IsCheckable="True" Click="AlwaysOnTopMenuItem_Click"/>
                <MenuItem x:Name="MinimizeToTrayMenuItem" Header="Minimize to tray" IsCheckable="True" Click="MinimizeToTrayMenuItem_Click"/>
                <MenuItem Header="Temperature">
                    <MenuItem x:Name="CelsiusMenuItem" Header="Celsius" IsCheckable="True" IsChecked="True" Click="CelsiusMenuItem_Click"/>
                    <MenuItem x:Name="FahrenheitMenuItem" Header="Fahrenheit" IsCheckable="True" Click="FahrenheitMenuItem_Click"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Language">
                <MenuItem Header="English" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Spanish" IsCheckable="True"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Documentation"/>
                <MenuItem Header="TechPvnk"/>
                <MenuItem Header="What do these readings mean?"/>
                <MenuItem Header="Check for Updates"/>
                <Separator/>
                <MenuItem Header="About Overseer..." Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="15" Background="#2D2D2D" Foreground="White" BorderBrush="#3F3F3F">

            <TabItem Header="Temps">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Background="#252526" CornerRadius="6" Padding="14" BorderBrush="#3F3F3F" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CPU" FontWeight="Bold" Foreground="#FF3B30"/>
                                    <TextBlock Text="{Binding CpuModel}" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CpuTemperature}" FontSize="30" FontWeight="Bold" Foreground="#FF3B30" Margin="0,12,0,0"/>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding CpuMinTemperature, StringFormat=Min {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding CpuMaxTemperature, StringFormat=Max {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding CpuUsage, StringFormat=Usage {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding CpuPower, StringFormat=Power {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding CpuMinPower, StringFormat=Min W {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding CpuMaxPower, StringFormat=Max W {0}}" Foreground="#BDBDBD"/>
                                    </UniformGrid>
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="16,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <views:Sparkline Values="{Binding CpuTemperatureHistory}" MaxValue="110" Stroke="#FF3B30" Height="88"/>
                                    <views:Sparkline Grid.Row="2" Values="{Binding CpuUsageHistory}" MaxValue="100" Stroke="#FF6A00" Height="88"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Background="#252526" CornerRadius="6" Padding="14" BorderBrush="#3F3F3F" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GPU" FontWeight="Bold" Foreground="#FF3B30"/>
                                    <TextBlock Text="{Binding GpuModel}" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding GpuTemperature}" FontSize="30" FontWeight="Bold" Foreground="#FF3B30" Margin="0,12,0,0"/>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding GpuMinTemperature, StringFormat=Min {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding GpuMaxTemperature, StringFormat=Max {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding GpuUsage, StringFormat=Usage {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding GpuPower, StringFormat=Power {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding GpuMinPower, StringFormat=Min W {0}}" Foreground="#BDBDBD"/>
                                        <TextBlock Text="{Binding GpuMaxPower, StringFormat=Max W {0}}" Foreground="#BDBDBD"/>
                                    </UniformGrid>
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="16,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <views:Sparkline Values="{Binding GpuTemperatureHistory}" MaxValue="110" Stroke="#FF3B30" Height="88"/>
                                    <views:Sparkline Grid.Row="2" Values="{Binding GpuUsageHistory}" MaxValue="100" Stroke="#FF6A00" Height="88"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Background="#252526" CornerRadius="6" Padding="14" BorderBrush="#3F3F3F" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Drives" FontWeight="Bold" Foreground="#FF3B30"/>

                                <ItemsControl ItemsSource="{Binding DriveTemperatures}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="230"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                                        <TextBlock Text="{Binding Temperature}" FontSize="30" FontWeight="Bold" Foreground="#FF3B30" Margin="0,12,0,0"/>
                                                        <UniformGrid Columns="2" Margin="0,8,0,0">
                                                            <TextBlock Text="{Binding MinTemperature, StringFormat=Min {0}}" Foreground="#BDBDBD"/>
                                                            <TextBlock Text="{Binding MaxTemperature, StringFormat=Max {0}}" Foreground="#BDBDBD"/>
                                                        </UniformGrid>
                                                    </StackPanel>

                                                    <views:Sparkline Grid.Column="1" Values="{Binding History}" MaxValue="110" Stroke="#FF3B30" Height="88" Margin="16,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Disk Health">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Connected Drives &amp; Health" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#FF3B30"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding StorageDrives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252526" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#3F3F3F" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                            <TextBlock Text="{Binding InterfaceType, StringFormat=Interface: {0}}" Foreground="#9CDCFE" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding ErrorFlag}" Foreground="#9CDCFE"/>
                                        </StackPanel>

                                        <UniformGrid Grid.Column="1" Columns="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Temperature, StringFormat=Temp: {0}}" Foreground="#4EC9B0"/>
                                            <TextBlock Text="{Binding LifeRemaining, StringFormat=Life Left: {0}}" Foreground="#DCDCAA"/>
                                        </UniformGrid>

                                        <UniformGrid Grid.Column="2" Columns="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding TotalReads, StringFormat=Reads: {0}}" Foreground="#9CDCFE"/>
                                            <TextBlock Text="{Binding TotalWrites, StringFormat=Writes: {0}}" Foreground="#9CDCFE"/>
                                            <TextBlock Text="{Binding PowerOnCount, StringFormat=Power Cycles: {0}}" Foreground="#9CDCFE"/>
                                            <TextBlock Text="{Binding PowerOnHours, StringFormat=Power Hours: {0}}" Foreground="#9CDCFE"/>
                                        </UniformGrid>

                                        <Border Grid.Column="3" Background="#333333" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HealthStatus}" FontWeight="Bold" Foreground="#4EC9B0" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <TabItem Header="System Info">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Background="#252526" CornerRadius="6" Padding="15" BorderBrush="#3F3F3F" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="CPU Info" FontSize="12" Foreground="#FF3B30"/>
                                <TextBlock Text="{Binding CpuModel}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding CpuClock, StringFormat=Clock: {0}}" Foreground="#BDBDBD" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="6" Padding="15" BorderBrush="#3F3F3F" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="RAM" FontSize="12" Foreground="#FF3B30"/>
                                <TextBlock Text="{Binding RamInfo}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="6" Padding="15" BorderBrush="#3F3F3F" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="GPU" FontSize="12" Foreground="#FF3B30"/>
                                <TextBlock Text="{Binding GpuModel}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Border Background="#252526" CornerRadius="6" Padding="15" BorderBrush="#3F3F3F" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Motherboard" FontSize="12" Foreground="#FF3B30"/>
                                <TextBlock Text="{Binding Motherboard}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="6" Padding="15" BorderBrush="#3F3F3F" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="BIOS" FontSize="12" Foreground="#FF3B30"/>
                                <TextBlock Text="{Binding Bios}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252526" CornerRadius="6" Padding="15" BorderBrush="#3F3F3F" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="OS Version" FontSize="12" Foreground="#FF3B30"/>
                                <TextBlock Text="{Binding OsVersion}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
